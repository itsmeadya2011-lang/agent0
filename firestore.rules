rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTask(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.type in ['computer_use', 'browser_use', 'file_editing', 'github_review', 'workspace_sync', 'general']
        && data.status in ['pending', 'running', 'completed', 'failed', 'paused'];
    }

    function isValidWorkspaceFile(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.path is string && data.path.size() > 0 && data.path.size() <= 256
        && data.name is string && data.name.size() > 0 && data.name.size() <= 128
        && data.content is string && data.content.size() <= 50000;
    }

    function isValidGithubWorkflow(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.repo is string && data.repo.size() > 0 && data.repo.size() <= 150
        && data.workflowType in ['code_review', 'test_and_build', 'deployment', 'security_audit']
        && data.status in ['queued', 'in_progress', 'passed', 'failed', 'deployed'];
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    match /tasks/{taskId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(taskId)
        && request.resource.data.userId == request.auth.uid
        && isValidTask(request.resource.data);
      allow update: if isSignedIn() && isValidId(taskId)
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && isValidTask(request.resource.data);
      allow delete: if isSignedIn() && isValidId(taskId)
        && resource.data.userId == request.auth.uid;
    }

    match /files/{fileId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(fileId)
        && request.resource.data.userId == request.auth.uid
        && isValidWorkspaceFile(request.resource.data);
      allow update: if isSignedIn() && isValidId(fileId)
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && isValidWorkspaceFile(request.resource.data);
      allow delete: if isSignedIn() && isValidId(fileId)
        && resource.data.userId == request.auth.uid;
    }

    match /githubWorkflows/{workflowId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(workflowId)
        && request.resource.data.userId == request.auth.uid
        && isValidGithubWorkflow(request.resource.data);
      allow update: if isSignedIn() && isValidId(workflowId)
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && isValidGithubWorkflow(request.resource.data);
      allow delete: if isSignedIn() && isValidId(workflowId)
        && resource.data.userId == request.auth.uid;
    }
  }
}
